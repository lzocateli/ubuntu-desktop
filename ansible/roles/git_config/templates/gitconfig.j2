# Gerenciado pelo Ansible. Altere as variaveis da role git_config.
{% if git_config_effective_user_name | length > 0 or git_config_effective_user_email | length > 0 %}
[user]
{% if git_config_effective_user_name | length > 0 %}
	name = {{ git_config_effective_user_name | to_json }}
{% endif %}
{% if git_config_effective_user_email | length > 0 %}
	email = {{ git_config_effective_user_email | to_json }}
{% endif %}
{% endif %}
[core]
	editor = code --wait
	autocrlf = input
	eol = lf
	safecrlf = warn
	filemode = true
	ignorecase = false
	quotepath = false
[sequence]
	editor = code --wait
[init]
	defaultBranch = main
[commit]
	verbose = true
[fetch]
	prune = true
	pruneTags = true
[pull]
	ff = only
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
	autoupdate = true
[diff]
	tool = vscode
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
[difftool]
	prompt = false
[difftool "vscode"]
	cmd = code --wait --diff "$LOCAL" "$REMOTE"
[merge]
	tool = vscode
	conflictStyle = zdiff3
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "vscode"]
	cmd = code --wait --merge "$REMOTE" "$LOCAL" "$BASE" "$MERGED"
	trustExitCode = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[help]
	autocorrect = 0
[credential]
	useHttpPath = true
{% if git_config_azure_devops_pat_enabled | bool %}
[credential "https://dev.azure.com/{{ git_config_azure_devops_organization }}"]
	helper =
	helper = {{ ('!' ~ ((ubuntu_desktop_home ~ '/.local/lib/ubuntu-desktop/git-credential-azure-devops.sh') | quote) ~ ' --organization ' ~ (git_config_azure_devops_organization | quote) ~ ' --username ' ~ (git_config_azure_devops_username | quote)) | to_json }}
{% endif %}
